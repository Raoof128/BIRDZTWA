# Docker ignore file

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Virtual environments
venv/
env/
ENV/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/*.log

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Git
.git/
.gitignore

# Documentation
*.md
!README.md

# Examples (optional, include if needed)
# examples/

# Reports (generated at runtime)
reports/*.md
reports/*.json

# Secrets
*.pem
*.key
.secrets/

# OS
.DS_Store
Thumbs.db

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# Temporary
*.tmp
tmp/
temp/

