[flake8]
# Flake8 Configuration

# Maximum line length
max-line-length = 100

# Ignore specific errors
extend-ignore =
    # E203: whitespace before ':' (conflicts with Black)
    E203,
    # W503: line break before binary operator (conflicts with Black)
    W503,
    # E501: line too long (handled by Black)
    E501

# Maximum complexity
max-complexity = 15

# Exclude directories
exclude =
    .git,
    __pycache__,
    .pytest_cache,
    .mypy_cache,
    venv,
    env,
    .venv,
    build,
    dist,
    *.egg-info,
    htmlcov,
    .tox,
    node_modules

# Per-file ignores
per-file-ignores =
    # Imported but unused in __init__.py files
    __init__.py:F401,F403
    # Tests can have long lines and unused imports
    tests/*.py:E501,F401

# Docstring conventions
docstring-convention = google

# Enable specific plugins
enable-extensions = G

# Show source code for errors
show-source = True

# Show statistics
statistics = True

# Count errors
count = True

